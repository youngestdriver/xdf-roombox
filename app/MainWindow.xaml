<Window x:Class="XdfRoombox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新东方云教室助手" Height="640" Width="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="新东方云教室助手" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="v1.0" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="8,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="DotProcess" Width="8" Height="8" Fill="{StaticResource ErrBrush}" Margin="0,0,5,0"/>
                <TextBlock Text="云教室" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0"/>
                <Ellipse x:Name="DotDebug" Width="8" Height="8" Fill="{StaticResource ErrBrush}" Margin="0,0,5,0"/>
                <TextBlock Text="调试端口" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0"/>
                <Ellipse x:Name="DotClass" Width="8" Height="8" Fill="{StaticResource ErrBrush}" Margin="0,0,5,0"/>
                <TextBlock Text="课堂" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 状态卡片 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="当前课程" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="TxtCurrent" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtCurrentTime" Text="" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                <Separator Margin="0,10" Background="{StaticResource BorderBrush2}"/>
                <TextBlock Text="下一节" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="TxtNext" Text="—" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtNextTime" Text="" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                <Separator Margin="0,10" Background="{StaticResource BorderBrush2}"/>
                <TextBlock x:Name="TxtStatus" Text="初始化..." FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 开关卡片 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ChkEnter" Grid.Row="0" Grid.Column="0" Content="自动进入教室" Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkSignIn" Grid.Row="0" Grid.Column="1" Content="自动签到" Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkExit" Grid.Row="1" Grid.Column="0" Content="下课自动退出" Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkEval" Grid.Row="1" Grid.Column="1" Content="自动提交评价" Checked="OnToggle" Unchecked="OnToggle"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="提前" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtAhead" Grid.Column="1" Text="15" Margin="6,0"/>
                    <TextBlock Grid.Column="2" Text="分钟进入 · 下课" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtExitDelay" Grid.Column="3" Text="5" Margin="6,0"/>
                    <TextBlock Grid.Column="4" Text="分钟退出 · 评价选第" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtEvalOpt" Grid.Column="5" Text="1" Margin="6,0"/>
                    <TextBlock Grid.Column="6" Text="项" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="6,2,0,6"/>
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnToggle" Content="暂停监控" Click="OnToggleMonitor" Margin="0,0,8,0"/>
                <Button Content="立即检查" Click="OnCheckNow" Margin="0,0,8,0"/>
                <Button Content="打开设置" Click="OnOpenSettings"/>
            </StackPanel>
            <TextBlock x:Name="TxtToken" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
        </Grid>
    </Grid>
</Window>
