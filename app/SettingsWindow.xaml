<Window x:Class="XdfRoombox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="420" Width="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="云教室路径" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
        <Grid Grid.Row="1" Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtExe" Grid.Column="0"/>
            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Click="OnBrowse"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="调试端口 / 轮询间隔（秒）" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,14">
            <TextBox x:Name="TxtPort" Width="100"/>
            <TextBox x:Name="TxtPoll" Width="100" Margin="12,0,0,0"/>
            <CheckBox x:Name="ChkMinimized" Content="启动时最小化窗口" Margin="16,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="评价意见（留空则不填写）" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
            <TextBox x:Name="TxtComment" Margin="0,6,0,0" Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="保存" Click="OnSave" Background="#2E5D8A"/>
        </StackPanel>
    </Grid>
</Window>
